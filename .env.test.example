# Copy to .env.test.local (gitignored) to enable the live Postgres suites.
#
#   cp .env.test.example .env.test.local
#   npm test
#
# Without this file those suites skip rather than fail, so `npm test` still
# passes on a machine with no database.
#
# The target database must have pgvector available:
#   CREATE EXTENSION IF NOT EXISTS vector;
#
# Each suite runs inside its own throwaway schema and drops it afterwards, so
# pointing at a database that already holds data is safe.

WOLBARG_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/wolbarg_test
